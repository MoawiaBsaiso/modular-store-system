From bef88be4bcab87b7f02d5d7ae171b4085adedd69 Mon Sep 17 00:00:00 2001
From: Salis Dev <dev@salis.app>
Date: Thu, 6 Aug 2026 20:19:37 +0000
Subject: [PATCH] fix: restore root package.json as monorepo config

root package.json was accidentally replaced with dashboard config
causing npm run dev to run Vite instead of Turbo
---
 package.json | 40 ++++++++++++++--------------------------
 1 file changed, 14 insertions(+), 26 deletions(-)

diff --git a/package.json b/package.json
index 6c3eba0..473e0ba 100644
--- a/package.json
+++ b/package.json
@@ -1,34 +1,22 @@
 {
-  "name": "dashboard",
+  "name": "modular-store-system",
+  "version": "1.0.0",
   "private": true,
-  "version": "0.0.0",
-  "type": "module",
+  "packageManager": "npm@10.8.2",
+  "workspaces": [
+    "apps/*",
+    "packages/*"
+  ],
   "scripts": {
-    "dev": "vite",
-    "build": "tsc && vite build",
-    "lint": "eslint .",
-    "preview": "vite preview"
-  },
-  "dependencies": {
-    "@clerk/clerk-react": "^5.61.7",
-    "@modular/types": "*",
-    "@modular/ui": "*",
-    "convex": "^1.39.1",
-    "react": "^19.0.0",
-    "react-dom": "^19.0.0"
+    "dev": "turbo run dev",
+    "build": "turbo run build",
+    "lint": "turbo run lint"
   },
   "devDependencies": {
-    "@eslint/js": "^9.15.0",
     "@types/react": "^19.0.0",
     "@types/react-dom": "^19.0.0",
-    "@vitejs/plugin-react": "^4.3.4",
-    "autoprefixer": "^10.5.0",
-    "eslint": "^9.15.0",
-    "eslint-plugin-react-hooks": "^5.0.0",
-    "eslint-plugin-react-refresh": "^0.4.14",
-    "postcss": "^8.4.49",
-    "tailwindcss": "^3.4.19",
-    "typescript": "^5.6.3",
-    "vite": "^6.0.1"
+    "convex": "^1.39.1",
+    "turbo": "^2.9.14",
+    "typescript": "^5.0.0"
   }
-}
\ No newline at end of file
+}
-- 
2.43.0

